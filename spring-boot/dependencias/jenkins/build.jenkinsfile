@Library('build-shared-library') _

buildPipeline([
    displayName: 'STARTER',
    projectAlias: 'starter',
    gitRepo: 'https://github.com/HerculanoLeo/java-hexagonal-architecture.git',
    gitCredential: 'github-herculano',
    discordWebhookUrl: 'https://discord.com/api/webhooks/REPLACE_ME',
    deployJob: 'lodh8/starter/deploy',
    buildAgent: 'worker',
    dockerImages: [
        'spring-boot/backend/api-cadastros/Dockerfile': [
            image: 'lodh8/starter-api-cadastros',
            context: 'spring-boot',
        ],
        'frontend/gestao/Dockerfile': [
            image: 'lodh8/starter-webapp-gestao',
            context: 'frontend/gestao',
        ],
    ],
    mavenBuilds: [
        [
            name: 'Backend',
            pomPath: './spring-boot/backend/pom.xml',
        ],
    ],
    nodeBuilds: [
        [
            name: 'Gestão',
            packageDir: './frontend/gestao',
            commands: [
                'pnpm install --frozen-lockfile --dir ./frontend/gestao',
                'pnpm --dir ./frontend/gestao build',
            ],
        ],
    ],
    // autoDeployEnvs: ['staging'],
])
