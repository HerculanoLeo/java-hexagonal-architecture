@Library('build-shared-library') _

buildPipeline([
    displayName: 'STARTER',
    projectAlias: 'starter',
    gitRepo: 'https://github.com/HerculanoLeo/java-hexagonal-architecture.git',
    gitCredential: 'github-herculano',
    devopsCredentials: 'devops',
    discordWebhookUrl: 'https://discord.com/api/webhooks/REPLACE_ME',
    deployJob: 'lodh8/starter/deploy',
    buildAgent: 'worker',
    dockerRegistry: 'https://artifacts.lodh8.com',
    dockerCredential: 'devops',
    dockerImages: [
        'spring-boot/backend/api-cadastros/Dockerfile': [
            image: 'artifacts.lodh8.com/lodh8/starter-api-cadastros',
            context: 'spring-boot',
        ],
    ],
    mavenBuilds: [
        [
            name: 'Backend',
            pomPath: './spring-boot/backend/pom.xml',
        ],
    ],
    // Frontend (gestão) fora do escopo por enquanto.
    // autoDeployEnvs: ['staging'],
])
